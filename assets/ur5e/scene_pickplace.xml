<mujoco model="ur5e pick-and-place">
  <include file="ur5e.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="960" offheight="540"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table" rgba="0.42 0.36 0.30 1" specular="0.2" shininess="0.1"/>
    <material name="wall" rgba="0.85 0.28 0.18 1" specular="0.3" shininess="0.2"/>
    <material name="cube" rgba="0.95 0.75 0.15 1" specular="0.4" shininess="0.3"/>
    <material name="place" rgba="0.20 0.55 0.40 1" specular="0.2" shininess="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      Table in front of the UR5e. Top is at z = 0.36. Home EE sits at
      ~(-0.13, 0.49, 0.49), so the flange is above the table, not in it.
      Pick is on −X, place on +X. A pillar between them sits on the table
      so the joint-space interpolant during the carry collides.
    -->
    <body name="table" pos="0.00 0.56 0.18">
      <geom name="table" type="box" size="0.42 0.22 0.18" material="table"
            contype="1" conaffinity="1"/>
    </body>

    <body name="pillar" pos="0.00 0.62 0.58">
      <geom name="pillar" type="box" size="0.05 0.05 0.22" material="wall"
            contype="1" conaffinity="1"/>
    </body>

    <!-- Green pad: visual-only marker for the place pose. -->
    <body name="place_pad" pos="0.22 0.58 0.361">
      <geom name="place_pad" type="box" size="0.05 0.05 0.002" material="place"
            contype="0" conaffinity="0"/>
    </body>

    <!--
      Visual/mocap-only cube: the demo welds it to the EE after pick and parks
      it on the pad after place. Its contact masks are zero, so it is excluded
      from planner collision geometry.
    -->
    <body name="cube" mocap="true" pos="-0.24 0.58 0.385">
      <geom name="cube" type="box" size="0.025 0.025 0.025" material="cube"
            contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>
