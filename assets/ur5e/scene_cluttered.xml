<mujoco model="ur5e cluttered">
  <include file="ur5e.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20" offwidth="960" offheight="540"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="obstacle" rgba="0.85 0.28 0.18 1" specular="0.3" shininess="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!--
      Pillar on the home shoulder-pan sweep. Home EE is at (-0.13, 0.49, 0.49);
      a +1.1 rad pan carries the tool through (-0.40, 0.32, 0.49). The joint-
      space straight line therefore collides; RRT-Connect has to lift or
      fold around the post.
    -->
    <body name="pillar" pos="-0.38 0.33 0.40">
      <geom name="pillar" type="box" size="0.07 0.07 0.40" material="obstacle"
            contype="1" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
